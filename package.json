{
  "name": "dsh-shelf",
  "version": "0.1.0",
  "description": "DeepSeek Harness 学习书架：按学习目标和科目管理教材、视频课和错题，AI 帮你生成目录、记录错题。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "study",
    "learning"
  ],
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "node scripts/build.mjs && node scripts/check-privacy.mjs --publish",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "check-privacy": "node scripts/check-privacy.mjs",
    "setup": "git config core.hooksPath .githooks"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "dependencies": {
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feolhn/dsh-shelf.git"
  },
  "homepage": "https://github.com/feolhn/dsh-shelf#readme"
}
