{
  "name": "dsh-palace",
  "version": "1.2.0",
  "description": "Memory Palace：DeepSeek Harness 插件，一个懂你在想什么的 AI。把书、课、剧和随手的念头放进一座宫殿，你只管记、只管聊，AI 帮你整理，也慢慢记住你。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "study",
    "learning",
    "reading",
    "epub"
  ],
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "node scripts/build.mjs && node scripts/check-privacy.mjs --publish",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./test/stubs/register.mjs --test test/*.test.mjs",
    "verify": "tsc --noEmit && pnpm test && node scripts/check-privacy.mjs && node scripts/build.mjs && npm --prefix demo install --no-audit --no-fund --silent && node demo/build.mjs",
    "demo": "npm --prefix demo install --no-audit --no-fund --silent && node demo/build.mjs --serve",
    "check-privacy": "node scripts/check-privacy.mjs",
    "setup": "git config core.hooksPath .githooks"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "dependencies": {
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feolhn/dsh-palace.git"
  },
  "homepage": "https://github.com/feolhn/dsh-palace#readme"
}
